{
  "name": "@universal/games",
  "version": "1.0.0",
  "description": "Universal Games Package with Performance Monitoring and Optimization",
  "main": "index.js",
  "types": "index.d.ts",
  "scripts": {
    "build": "npm run build:android && npm run build:ios",
    "build:android": "./scripts/build_android.sh",
    "build:ios": "./scripts/build_ios.sh",
    "build:all": "npm run build",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.js",
    "format": "prettier --write 'src/**/*.js'",
    "release": "npm run build && npm publish",
    "release:major": "npm version major && npm run release",
    "release:minor": "npm version minor && npm run release",
    "release:patch": "npm version patch && npm run release",
    "deploy": "gh release create v$npm_package_version --generate-notes",
    "docs": "jsdoc -c jsdoc.json",
    "clean": "rm -rf build/ dist/ node_modules/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yourusername/universal-games-package.git"
  },
  "keywords": [
    "games",
    "performance",
    "monitoring",
    "fps",
    "temperature",
    "gpu",
    "anti-lag",
    "thermal",
    "optimization",
    "universal-games",
    "mobile",
    "ios",
    "android",
    "gaming",
    "performance-monitor"
  ],
  "author": "Universal Games Team",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/yourusername/universal-games-package/issues"
  },
  "homepage": "https://github.com/yourusername/universal-games-package#readme",
  "devDependencies": {
    "@actions/core": "^1.10.1",
    "@actions/github": "^5.1.1",
    "@types/jest": "^29.5.5",
    "@types/node": "^20.8.0",
    "@typescript-eslint/eslint-plugin": "^6.7.4",
    "@typescript-eslint/parser": "^6.7.4",
    "eslint": "^8.50.0",
    "jest": "^29.7.0",
    "prettier": "^3.0.3",
    "ts-jest": "^29.1.1",
    "typescript": "^5.2.2"
  },
  "dependencies": {
    "rxjs": "^7.8.1",
    "axios": "^1.6.0",
    "lodash": "^4.17.21"
  },
  "peerDependencies": {
    "react-native": ">=0.70.0"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "files": [
    "dist/",
    "src/",
    "docs/",
    "LICENSE",
    "README.md",
    "Package.swift"
  ],
  "publishConfig": {
    "access": "public"
  }
}
